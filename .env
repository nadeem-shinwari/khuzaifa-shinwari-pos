# ---------------------------------------------------------------------------
# Khuzaifa Shinwari Management App - environment configuration
# ---------------------------------------------------------------------------
# Copy this file to ".env" and adjust the values for your machine.
# NEVER commit a real .env file and NEVER expose it inside the public web root.
# ---------------------------------------------------------------------------

# Application
APP_NAME="Khuzaifa Shinwari"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Karachi

# Database
# Local development uses the XAMPP MySQL/MariaDB server.
DB_CONNECTION=mysql

# SQLite is retained only for optional offline/legacy use.
DB_SQLITE_PATH=backend/storage/sqlite/app.sqlite

# MySQL: read from the hosting control panel. Never put production credentials
# in Vite environment variables or in any file inside the built frontend.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=khuzaifa_management
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Session / cookie security
SESSION_NAME=ks_session
SESSION_LIFETIME=7200
# Set to true when the site is served over HTTPS (recommended in production).
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=Lax
