# ---------------------------------------------------------------------------
# Khuzaifa Shinwari Management App - environment configuration
# ---------------------------------------------------------------------------
# Copy this file to ".env" and adjust the values for your machine.
# NEVER commit a real .env file and NEVER expose it inside the public web root.
# ---------------------------------------------------------------------------

# Application
APP_NAME="Khuzaifa Shinwari"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Karachi

# Database
# Local development uses XAMPP MySQL/MariaDB; production uses InfinityFree MySQL.
DB_CONNECTION=mysql

# SQLite (optional legacy/offline use only)
DB_SQLITE_PATH=backend/storage/sqlite/app.sqlite

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_database_name
DB_USERNAME=your_mysql_username
DB_PASSWORD=your_mysql_password
DB_CHARSET=utf8mb4

# Session / cookie security
SESSION_NAME=ks_session
SESSION_LIFETIME=7200
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=Lax
